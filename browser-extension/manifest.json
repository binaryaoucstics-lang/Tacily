{
  "manifest_version": 3,
  "name": "全局 AI 翻译器 · 网页与图片",
  "version": "0.9.3",
  "description": "智能判断当前网页语言，分段并发流式翻译正文与图片，保留页面结构并跟随滚动。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "scroll-accumulator.js",
        "translation-motion.js",
        "content.js",
        "image-geometry.js",
        "image-overlay.js",
        "image-auto-policy.js",
        "image-content.js",
        "page-auto-policy.js",
        "page-auto-content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
