{
  "manifest_version": 3,
  "name": "默译 · Tacily · 网页与图片",
  "version": "0.9.3",
  "description": "自动识别需要翻译的网页与图片，在原位置流式呈现译文，让理解自然发生。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequestWithHostAccess"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "scroll-accumulator.js",
        "translation-motion.js",
        "content.js",
        "image-geometry.js",
        "image-overlay.js",
        "image-auto-policy.js",
        "image-content.js",
        "page-auto-policy.js",
        "page-auto-content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
